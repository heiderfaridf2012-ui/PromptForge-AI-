        let appState = loadInitialState();
        let activeModalTemplate = null;

        function loadInitialState() {
            try {
                const stored = localStorage.getItem('promptforge_state_v1');
                if (stored) {
                    return { ...DEFAULT_STATE, ...JSON.parse(stored) };
                }
            } catch (e) {
                console.error('Error al cargar estado', e);
            }
            return { ...DEFAULT_STATE };
        }

        function saveState() {
            try {
                localStorage.setItem('promptforge_state_v1', JSON.stringify(appState));
            } catch (e) {
                console.error('Error al guardar estado', e);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            restoreFormValues();
            renderCategoryChips();
            renderLibrary();
            updateSavedCount();
            updateLibraryCount();
            updateBuilderPreview();
            switchTab(appState.activeTab, false);
            lucide.createIcons();
        });

        function restoreFormValues() {
            if (appState.builderForm) {
                document.getElementById('b_role').value = appState.builderForm.role || '';
                document.getElementById('b_context').value = appState.builderForm.context || '';
                document.getElementById('b_task').value = appState.builderForm.task || '';
                document.getElementById('b_format').value = appState.builderForm.format || '';
                document.getElementById('b_tone').value = appState.builderForm.tone || '';
                document.getElementById('b_constraints').value = appState.builderForm.constraints || '';
            }
            const enhInput = document.getElementById('enhancerInput');
            if (enhInput) enhInput.value = appState.enhancerInput || '';
            const searchInput = document.getElementById('searchInput');
            if (searchInput) searchInput.value = appState.searchQuery || '';
            const platformFilter = document.getElementById('platformFilter');
            if (platformFilter) platformFilter.value = appState.selectedPlatform || 'Todas';
        }

        function renderCategoryChips() {
            const container = document.getElementById('categoryChips');
            if (!container) return;
            container.innerHTML = CATEGORIES.map(cat => `
                <button onclick="filterCategory('${cat}')" class="px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border ${
                    appState.selectedCategory === cat 
                    ? 'bg-indigo-500/20 text-indigo-300 border-indigo-500/50 shadow-md' 
                    : 'bg-dark-800 text-slate-400 border-dark-700 hover:bg-dark-700 hover:text-slate-200'
                }">${cat}</button>
            `).join('');
        }

        function filterCategory(cat) {
            appState.selectedCategory = cat;
            saveState();
            renderCategoryChips();
            renderLibrary();
        }

        function renderLibrary() {
            const container = document.getElementById('libraryGrid');
            if (!container) return;
            const searchVal = document.getElementById('searchInput')?.value.toLowerCase() || '';
            const platformVal = document.getElementById('platformFilter')?.value || 'Todas';

            appState.searchQuery = searchVal;
            appState.selectedPlatform = platformVal;
            saveState();

            const filtered = PROMPT_LIBRARY.filter(tmpl => {
                const matchesCat = appState.selectedCategory === 'Todas' || tmpl.category === appState.selectedCategory;
                const matchesPlat = platformVal === 'Todas' || tmpl.platform === platformVal;
                const matchesSearch = tmpl.title.toLowerCase().includes(searchVal) || tmpl.description.toLowerCase().includes(searchVal);
                return matchesCat && matchesPlat && matchesSearch;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-12 text-slate-500 bg-dark-900/30 rounded-2xl border border-dark-800">
                        <i data-lucide="search-x" class="w-10 h-10 mx-auto mb-3 text-slate-600"></i>
                        <p class="text-xs sm:text-sm">No se encontraron plantillas.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = filtered.map(tmpl => `
                <div class="bg-dark-900/60 border border-dark-800 rounded-2xl p-4 sm:p-5 hover:border-indigo-500/40 transition-all flex flex-col justify-between group shadow-lg">
