<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PromptForge AI - Creador y Biblioteca de Prompts</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dark: {
                            950: '#0a0a0c',
                            900: '#121216',
                            800: '#1a1a22',
                            700: '#272733',
                            600: '#3f3f52',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0a0c;
            color: #f4f4f5;
        }
        code, pre, .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #121216;
        }
        ::-webkit-scrollbar-thumb {
            background: #272733;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3f3f52;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-dark-950 text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white pb-20 md:pb-0 transition-colors duration-300" id="bodyRoot">

    <!-- HEADER / NAVBAR -->
    <header class="border-b border-dark-800 bg-dark-900/90 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-600 rounded-xl shadow-lg shadow-indigo-500/20">
                        <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <span class="text-base sm:text-lg font-bold bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
                            PromptForge AI
                        </span>
                        <span class="hidden sm:inline-block text-[10px] bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-2 py-0.5 rounded-full ml-2 font-mono">
                            v3.5 Pro (80 Prompts)
                        </span>
                    </div>
                </div>

                <!-- Desktop Navigation Tabs -->
                <nav class="hidden md:flex items-center gap-1 bg-dark-950 p-1 rounded-xl border border-dark-800">
                    <button onclick="switchTab('builder')" id="nav-builder" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5">
                        <i data-lucide="wand-2" class="w-4 h-4"></i>
                        <span>Creador</span>
                    </button>
                    <button onclick="switchTab('library')" id="nav-library" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                        <span>Biblioteca</span>
                        <span id="libraryCount" class="px-1.5 py-0.5 text-[10px] rounded-md bg-dark-800 text-indigo-300 font-mono">80</span>
                    </button>
                    <button onclick="switchTab('enhancer')" id="nav-enhancer" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5">
                        <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
                        <span>IA Optim</span>
                    </button>
                    <button onclick="switchTab('saved')" id="nav-saved" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5">
                        <i data-lucide="bookmark" class="w-4 h-4 text-emerald-400"></i>
                        <span>Guardados</span>
                        <span id="savedCount" class="px-1.5 py-0.5 text-[10px] rounded-md bg-dark-800 text-emerald-300 font-mono">0</span>
                    </button>
                    <button onclick="switchTab('stats')" id="nav-stats" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 text-sky-400"></i>
                        <span>Stats</span>
                    </button>
                </nav>

                <!-- Quick actions -->
                <div class="flex items-center gap-2">
                    <button onclick="exportSavedPrompts()" class="px-2.5 py-1.5 bg-dark-800 hover:bg-dark-700 text-slate-300 rounded-xl text-xs font-medium transition-all flex items-center gap-1.5 border border-dark-700" title="Exportar Prompts Guardados">
                        <i data-lucide="download" class="w-3.5 h-3.5 text-indigo-400"></i>
                        <span class="hidden sm:inline">Exportar</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- MOBILE BOTTOM NAVIGATION -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-dark-900/95 backdrop-blur-lg border-t border-dark-800 z-40 px-1 py-1.5 flex justify-around items-center">
        <button onclick="switchTab('builder')" id="m-nav-builder" class="flex flex-col items-center gap-0.5 p-1 rounded-lg text-slate-400 transition-all">
            <i data-lucide="wand-2" class="w-4 h-4"></i>
            <span class="text-[9px] font-medium">Creador</span>
        </button>
        <button onclick="switchTab('library')" id="m-nav-library" class="flex flex-col items-center gap-0.5 p-1 rounded-lg text-slate-400 transition-all">
            <i data-lucide="book-open" class="w-4 h-4"></i>
            <span class="text-[9px] font-medium">Biblioteca</span>
        </button>
        <button onclick="switchTab('enhancer')" id="m-nav-enhancer" class="flex flex-col items-center gap-0.5 p-1 rounded-lg text-slate-400 transition-all">
            <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
            <span class="text-[9px] font-medium">IA Optim</span>
        </button>
        <button onclick="switchTab('saved')" id="m-nav-saved" class="flex flex-col items-center gap-0.5 p-1 rounded-lg text-slate-400 transition-all">
            <i data-lucide="bookmark" class="w-4 h-4 text-emerald-400"></i>
            <span class="text-[9px] font-medium">Guardados</span>
        </button>
        <button onclick="switchTab('stats')" id="m-nav-stats" class="flex flex-col items-center gap-0.5 p-1 rounded-lg text-slate-400 transition-all">
            <i data-lucide="bar-chart-3" class="w-4 h-4 text-sky-400"></i>
            <span class="text-[9px] font-medium">Stats</span>
        </button>
    </nav>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- TAB 1: CREADOR DE PROMPTS (BUILDER) -->
        <section id="tab-builder" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Form Area (7 Cols) -->
                <div class="lg:col-span-7 bg-dark-900/60 border border-dark-800 rounded-2xl p-4 sm:p-5 space-y-4 shadow-xl">
                    <div class="flex items-center justify-between pb-3 border-b border-dark-800">
                        <h2 class="text-sm sm:text-base font-bold text-slate-200 flex items-center gap-2">
                            <i data-lucide="sliders" class="w-4 h-4 text-indigo-400"></i>
                            Estructura del Prompt Avanzada
                        </h2>
                        <button onclick="resetBuilderForm()" class="text-xs text-slate-400 hover:text-rose-400 transition-colors flex items-center gap-1">
                            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Limpiar
                        </button>
                    </div>

                    <div class="space-y-3.5 text-xs">
                        <div>
                            <label class="block font-medium text-slate-300 mb-1">Rol / Persona</label>
                            <input type="text" id="b_role" oninput="updateBuilderPreview()" placeholder="Ej: Actúa como un Senior Full Stack Developer y Experto en Clean Code..." class="w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500">
                        </div>

                        <div>
                            <label class="block font-medium text-slate-300 mb-1">Contexto / Situación Actual</label>
                            <textarea id="b_context" oninput="updateBuilderPreview()" rows="2" placeholder="Ej: Tengo una aplicación web en producción con problemas de rendimiento..." class="w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500 resize-y"></textarea>
                        </div>

                        <div>
                            <label class="block font-medium text-slate-300 mb-1">Tarea Principal / Instrucción Central</label>
                            <textarea id="b_task" oninput="updateBuilderPreview()" rows="2" placeholder="Ej: Revisa y refactoriza el siguiente fragmento de código..." class="w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500 resize-y"></textarea>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block font-medium text-slate-300 mb-1">Formato de Salida</label>
                                <input type="text" id="b_format" oninput="updateBuilderPreview()" placeholder="Ej: Tabla, Markdown, JSON..." class="w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="block font-medium text-slate-300 mb-1">Tono / Estilo</label>
                                <input type="text" id="b_tone" oninput="updateBuilderPreview()" placeholder="Ej: Profesional, Didáctico, Directo..." class="w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500">
                            </div>
                        </div>

                        <div>
                            <label class="block font-medium text-slate-300 mb-1">Restricciones / Qué EVITAR</label>
                            <input type="text" id="b_constraints" oninput="updateBuilderPreview()" placeholder="Ej: No uses jerga rebuscada, evita explicaciones largas..." class="w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-slate-200 focus:outline-none focus:border-indigo-500">
                        </div>
                    </div>
                </div>

                <!-- Preview Area (5 Cols) -->
                <div class="lg:col-span-5 bg-dark-900/60 border border-dark-800 rounded-2xl p-4 sm:p-5 flex flex-col justify-between space-y-4 shadow-xl">
                    <div class="space-y-3">
                        <div class="flex items-center justify-between pb-3 border-b border-dark-800">
                            <h2 class="text-sm sm:text-base font-bold text-slate-200 flex items-center gap-2">
                                <i data-lucide="eye" class="w-4 h-4 text-emerald-400"></i>
                                Vista Previa en Tiempo Real
                            </h2>
                            <span id="builderCharCount" class="text-[10px] font-mono bg-dark-950 text-slate-400 px-2 py-0.5 rounded-md border border-dark-800">0 chars</span>
                        </div>

                        <div id="builderPreviewBox" class="w-full h-64 sm:h-80 bg-dark-950 border border-dark-800 rounded-xl p-4 overflow-y-auto text-xs font-mono text-indigo-100 leading-relaxed whitespace-pre-wrap"></div>
                    </div>

                    <div class="flex items-center gap-2 pt-2 border-t border-dark-800">
                        <button onclick="copyBuilderPrompt()" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 px-4 rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/20 active:scale-95">
                            <i data-lucide="copy" class="w-4 h-4"></i> Copiar Prompt
                        </button>
                        <button onclick="saveBuilderPrompt()" class="bg-dark-800 hover:bg-dark-700 text-emerald-400 p-2.5 rounded-xl border border-dark-700 transition-all active:scale-95" title="Guardar en Colección">
                            <i data-lucide="bookmark" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: BIBLIOTECA DE PLANTILLAS -->
        <section id="tab-library" class="hidden space-y-6">
            <div class="bg-dark-900/60 border border-dark-800 rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
                <div class="flex flex-col sm:flex-row gap-3">
                    <div class="relative flex-1">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="searchInput" oninput="renderLibrary()" placeholder="Buscar entre las 80 plantillas profesionales..." class="w-full pl-10 pr-4 py-2.5 bg-dark-950 border border-dark-800 rounded-xl text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-all">
                    </div>
                    <div class="flex gap-2">
                        <select id="platformFilter" onchange="renderLibrary()" class="w-full sm:w-auto bg-dark-950 border border-dark-800 rounded-xl px-3 py-2.5 text-xs text-slate-300 focus:outline-none focus:border-indigo-500 transition-all">
                            <option value="Todas">Todas las IAs</option>
                            <option value="ChatGPT">ChatGPT</option>
                            <option value="Claude">Claude</option>
                            <option value="Gemini">Gemini</option>
                            <option value="DeepSeek">DeepSeek</option>
                            <option value="Llama">Llama</option>
                            <option value="Mistral">Mistral</option>
                            <option value="Perplexity">Perplexity</option>
                            <option value="Midjourney">Midjourney</option>
                        </select>
                    </div>
                </div>

                <div id="categoryChips" class="flex gap-2 overflow-x-auto pb-1 pt-1 no-scrollbar"></div>
            </div>

            <div id="libraryGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        </section>

        <!-- TAB 3: MEJORAR CON IA (ENHANCER) -->
        <section id="tab-enhancer" class="hidden space-y-6 max-w-3xl mx-auto">
            <div class="bg-dark-900/60 border border-dark-800 rounded-2xl p-5 sm:p-6 shadow-xl space-y-5">
                <div class="text-center space-y-2">
                    <div class="inline-flex p-3 bg-amber-500/10 border border-amber-500/20 rounded-2xl text-amber-400 mb-1">
                        <i data-lucide="sparkles" class="w-6 h-6"></i>
                    </div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-100">Optimizador Inteligente de Prompts</h2>
                    <p class="text-xs text-slate-400 max-w-md mx-auto">
                        Introduce una idea o borrador simple. Lo transformaremos automáticamente en un prompt altamente estructurado.
                    </p>
                </div>

                <div class="space-y-3">
                    <label class="block text-xs font-medium text-slate-300">Tu borrador básico:</label>
                    <textarea id="enhancerInput" rows="3" placeholder="Ej: Ideas de contenido para mi blog sobre marketing digital..." class="w-full px-4 py-3 bg-dark-950 border border-dark-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-amber-500 transition-all resize-y"></textarea>
                    
                    <button onclick="enhancePrompt()" class="w-full bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold py-2.5 px-4 rounded-xl text-xs transition-all shadow-lg shadow-amber-500/10 flex items-center justify-center gap-2 active:scale-98">
                        <i data-lucide="zap" class="w-4 h-4"></i> Estructurar Prompt con IA
                    </button>
                </div>

                <div id="enhancerResultBox" class="hidden space-y-3 pt-4 border-t border-dark-800">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
                            <i data-lucide="check-circle-2" class="w-4 h-4"></i> Prompt Optimizado Listo
                        </span>
                        <div class="flex items-center gap-2">
                            <button onclick="saveEnhancedPrompt()" class="text-xs bg-dark-800 hover:bg-dark-700 text-emerald-400 px-2.5 py-1 rounded-lg border border-dark-700 flex items-center gap-1">
                                <i data-lucide="bookmark" class="w-3 h-3"></i> Guardar
                            </button>
                            <button onclick="copyToClipboard(document.getElementById('enhancedOutput').innerText)" class="text-xs text-slate-400 hover:text-slate-200 flex items-center gap-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copiar
                            </button>
                        </div>
                    </div>
                    <div id="enhancedOutput" class="p-4 bg-dark-950 border border-dark-800 rounded-xl text-xs font-mono text-indigo-100 leading-relaxed whitespace-pre-wrap"></div>
                </div>
            </div>
        </section>

        <!-- TAB 4: MIS PROMPTS GUARDADOS -->
        <section id="tab-saved" class="hidden space-y-6">
            <div class="bg-dark-900/60 border border-dark-800 rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                    <h2 class="text-base font-bold text-slate-200 flex items-center gap-2">
                        <i data-lucide="bookmark" class="w-4 h-4 text-emerald-400"></i>
                        Mi Colección Personal
                    </h2>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <div class="relative flex-1 sm:w-64">
                            <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            <input type="text" id="savedSearchInput" oninput="renderSavedPrompts()" placeholder="Buscar en guardados..." class="w-full pl-9 pr-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                        </div>
                        <button onclick="exportSavedPrompts()" class="px-3 py-2 bg-dark-800 hover:bg-dark-700 text-slate-300 rounded-xl text-xs font-medium transition-all flex items-center gap-1.5 border border-dark-700 shrink-0">
                            <i data-lucide="download" class="w-3.5 h-3.5 text-indigo-400"></i> <span class="hidden sm:inline">Exportar JSON</span>
                        </button>
                    </div>
                </div>
            </div>

            <div id="savedGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
        </section>

        <!-- TAB 5: ESTADÍSTICAS Y MÉTRICAS -->
        <section id="tab-stats" class="hidden space-y-6 max-w-4xl mx-auto">
            <div class="bg-dark-900/60 border border-dark-800 rounded-2xl p-5 sm:p-6 shadow-xl space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-dark-800">
                    <h2 class="text-base font-bold text-slate-100 flex items-center gap-2">
                        <i data-lucide="bar-chart-3" class="w-5 h-5 text-sky-400"></i>
                        Estadísticas de Uso y Biblioteca
                    </h2>
                    <span class="text-xs font-mono bg-sky-500/10 text-sky-400 px-3 py-1 rounded-full border border-sky-500/20">Resumen en vivo</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-dark-950 border border-dark-800 p-4 rounded-2xl flex items-center gap-4">
                        <div class="p-3 bg-indigo-600/10 text-indigo-400 rounded-xl border border-indigo-500/20">
                            <i data-lucide="book-open" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400">Total Modelos</p>
                            <p id="statTotalModels" class="text-xl font-bold text-slate-100">80</p>
                        </div>
                    </div>
                    <div class="bg-dark-950 border border-dark-800 p-4 rounded-2xl flex items-center gap-4">
                        <div class="p-3 bg-emerald-600/10 text-emerald-400 rounded-xl border border-emerald-500/20">
                            <i data-lucide="bookmark" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400">Prompts Guardados</p>
                            <p id="statSavedPrompts" class="text-xl font-bold text-slate-100">0</p>
                        </div>
                    </div>
                    <div class="bg-dark-950 border border-dark-800 p-4 rounded-2xl flex items-center gap-4">
                        <div class="p-3 bg-sky-600/10 text-sky-400 rounded-xl border border-sky-500/20">
                            <i data-lucide="cpu" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400">IAs Soportadas</p>
                            <p class="text-xl font-bold text-slate-100">8</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-3 pt-2">
                    <h3 class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Distribución por Motor de IA</h3>
                    <div id="aiDistributionBars" class="space-y-2 text-xs">
                        <!-- Generado dinámicamente -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- MODAL DE VARIABLES DINÁMICAS -->
    <div id="variableModal" class="fixed inset-0 bg-dark-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-dark-900 border border-dark-800 rounded-2xl max-w-lg w-full p-5 sm:p-6 space-y-5 shadow-2xl relative max-h-[90vh] flex flex-col">
            <button onclick="closeVariableModal()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-300 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="space-y-1 pr-6">
                <h3 id="modalTitle" class="text-sm sm:text-base font-bold text-slate-100">Personalizar Plantilla</h3>
                <p class="text-xs text-slate-400">Rellena los campos para personalizar el prompt automáticamente.</p>
            </div>

            <div id="modalFormFields" class="space-y-3 overflow-y-auto pr-1 flex-1"></div>

            <div class="space-y-2 pt-2 border-t border-dark-800">
                <label class="block text-[11px] font-mono text-slate-400">Resultado Final:</label>
                <div id="modalPreviewText" class="p-3 bg-dark-950 border border-dark-800 rounded-xl text-xs font-mono text-indigo-100 max-h-36 overflow-y-auto whitespace-pre-wrap"></div>
            </div>

            <div class="flex gap-3 pt-2">
                <button onclick="copyModalPrompt()" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 px-4 rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/20 active:scale-95">
                    <i data-lucide="copy" class="w-4 h-4"></i> Copiar Prompt Personalizado
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE EDICIÓN -->
    <div id="editModal" class="fixed inset-0 bg-dark-950/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-dark-900 border border-dark-800 rounded-2xl max-w-lg w-full p-5 sm:p-6 space-y-4 shadow-2xl relative">
            <button onclick="closeEditModal()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-300 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
            <h3 class="text-base font-bold text-slate-100">Editar Prompt Guardado</h3>
