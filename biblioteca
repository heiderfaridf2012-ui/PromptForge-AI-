                        <button onclick="openVariablesModal('${tmpl.id}')" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs py-2 px-3 rounded-xl transition-all flex items-center justify-center gap-1.5 shadow-md active:scale-95">
                            <i data-lucide="sliders" class="w-3.5 h-3.5"></i> Usar Plantilla
                        </button>
                        <button onclick="copyToClipboard(\`${tmpl.prompt.replace(/`/g, '\\`')}\`)" class="bg-dark-800 hover:bg-dark-700 text-slate-200 p-2 rounded-xl transition-all border border-dark-700 active:scale-95" title="Copiar Directo">
