        function switchTab(tabId, persist = true) {
            if (persist) {
                appState.activeTab = tabId;
                saveState();
            }

            const tabs = ['builder', 'library', 'enhancer', 'saved', 'stats'];
            tabs.forEach(id => {
                document.getElementById(`tab-${id}`)?.classList.add('hidden');
                const nav = document.getElementById(`nav-${id}`);
                const mNav = document.getElementById(`m-nav-${id}`);
                if (nav) nav.className = "px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 transition-all flex items-center gap-1.5";
                if (mNav) mNav.className = "flex flex-col items-center gap-0.5 p-1 rounded-lg text-slate-400 transition-all";
            });

            document.getElementById(`tab-${tabId}`)?.classList.remove('hidden');
            const targetNav = document.getElementById(`nav-${tabId}`);
            const targetMNav = document.getElementById(`m-nav-${tabId}`);
            if (targetNav) targetNav.className = "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-indigo-600 text-white font-bold shadow-md";
            if (targetMNav) targetMNav.className = "flex flex-col items-center gap-0.5 p-1 rounded-lg text-indigo-300 font-semibold bg-dark-800 transition-all";

            if (tabId === 'saved') renderSavedPrompts();
            if (tabId === 'stats') renderStats();
            lucide.createIcons();
        }

        function updateBuilderPreview() {
            const role = document.getElementById('b_role')?.value || '';
            const context = document.getElementById('b_context')?.value || '';
            const task = document.getElementById('b_task')?.value || '';
            const format = document.getElementById('b_format')?.value || '';
            const tone = document.getElementById('b_tone')?.value || '';
            const constraints = document.getElementById('b_constraints')?.value || '';

            appState.builderForm = { role, context, task, format, tone, constraints };
            saveState();

            let fullText = '';
            if (role) fullText += `Rol: ${role}\n\n`;
            if (context) fullText += `Contexto: ${context}\n\n`;
            if (task) fullText += `Tarea Principal: ${task}\n\n`;
            if (format) fullText += `Formato de Salida: ${format}\n\n`;
            if (tone) fullText += `Tono y Estilo: ${tone}\n\n`;
            if (constraints) fullText += `Restricciones: ${constraints}\n\n`;

            const previewBox = document.getElementById('builderPreviewBox');
            const countBox = document.getElementById('builderCharCount');
            if (previewBox) previewBox.innerText = fullText.trim() || 'Completa los campos para ver el prompt...';
            if (countBox) countBox.innerText = `${fullText.trim().length} chars`;
        }

        function resetBuilderForm() {
            ['b_role', 'b_context', 'b_task', 'b_format', 'b_tone', 'b_constraints'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            updateBuilderPreview();
        }

        function copyBuilderPrompt() {
            const text = document.getElementById('builderPreviewBox')?.innerText || '';
            if (text && !text.startsWith('Completa')) copyToClipboard(text);
            else showToast('Escribe algo en el creador primero.', 'error');
        }

        function saveBuilderPrompt() {
            const text = document.getElementById('builderPreviewBox')?.innerText || '';
            if (!text || text.startsWith('Completa')) {
                showToast('Crea un prompt antes de guardar.', 'error');
                return;
            }
            appState.savedPrompts.push({
                id: 'saved-' + Date.now(),
                title: 'Personalizado ' + new Date().toLocaleDateString(),
                category: 'Personalizado',
                platform: 'General',
                prompt: text,
                date: new Date().toLocaleDateString()
            });
            saveState();
            updateSavedCount();
            showToast('Prompt guardado exitosamente');
        }

        function enhancePrompt() {
            const inputVal = document.getElementById('enhancerInput')?.value.trim() || '';
            if (!inputVal) {
                showToast('Introduce un borrador primero', 'error');
                return;
            }
            appState.enhancerInput = inputVal;
            saveState();

            const enhanced = `Actúa como un Experto Senior y Asistente de IA Avanzado.\n\nObjetivo Principal:\n${inputVal}\n\nInstrucciones de Ejecución:\n1. Analiza con rigor técnico y estratégico.\n2. Proporciona soluciones paso a paso con ejemplos claros.\n3. Asegura máxima calidad y buenas prácticas.`;
            
            const outputEl = document.getElementById('enhancedOutput');
            const boxEl = document.getElementById('enhancerResultBox');
            if (outputEl && boxEl) {
                outputEl.innerText = enhanced;
                boxEl.classList.remove('hidden');
                lucide.createIcons();
            }
        }

        function saveEnhancedPrompt() {
            const text = document.getElementById('enhancedOutput')?.innerText || '';
            if (!text) return;
            appState.savedPrompts.push({
                id: 'saved-' + Date.now(),
                title: 'Optimizado por IA',
                category: 'IA Optimizada',
                platform: 'General',
                prompt: text,
                date: new Date().toLocaleDateString()
            });
            saveState();
            updateSavedCount();
            showToast('Prompt optimizado guardado');
        }

        function openVariablesModal(id) {
            const tmpl = PROMPT_LIBRARY.find(t => t.id === id);
            if (!tmpl) return;
            activeModalTemplate = tmpl;

            document.getElementById('modalTitle').innerText = tmpl.title;
            const matches = tmpl.prompt.match(/\[(.*?)\]/g) || [];
            const uniqueVars = [...new Set(matches)];
            const formContainer = document.getElementById('modalFormFields');

            if (uniqueVars.length === 0) {
                formContainer.innerHTML = '<p class="text-xs text-slate-400">Sin variables modificables.</p>';
            } else {
                formContainer.innerHTML = uniqueVars.map(varName => `
                    <div>
                        <label class="block text-xs font-medium text-slate-300 capitalize mb-1">${varName.replace(/[\[\]_]/g, ' ')}</label>
                        <input type="text" data-var="${varName}" oninput="updateModalPreview()" placeholder="Valor..." class="modal-var-input w-full px-3 py-2 bg-dark-950 border border-dark-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                    </div>
                `).join('');
            }
            updateModalPreview();
            document.getElementById('variableModal')?.classList.remove('hidden');
            lucide.createIcons();
        }

        function updateModalPreview() {
            if (!activeModalTemplate) return;
            let text = activeModalTemplate.prompt;
            document.querySelectorAll('.modal-var-input').forEach(input => {
                const varTag = input.getAttribute('data-var');
                const val = input.value.trim();
                if (varTag && val) text = text.replaceAll(varTag, val);
            });
            document.getElementById('modalPreviewText').innerText = text;
        }

        function copyModalPrompt() {
            const text = document.getElementById('modalPreviewText')?.innerText;
            if (text) {
                copyToClipboard(text);
                closeVariableModal();
            }
        }

        function closeVariableModal() {
            document.getElementById('variableModal')?.classList.add('hidden');
            activeModalTemplate = null;
        }

        function renderSavedPrompts() {
            const container = document.getElementById('savedGrid');
            if (!container) return;
            const searchVal = document.getElementById('savedSearchInput')?.value.toLowerCase() || '';
            const filtered = appState.savedPrompts.filter(item => item.title.toLowerCase().includes(searchVal) || item.prompt.toLowerCase().includes(searchVal));

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-12 text-slate-500 bg-dark-900/30 rounded-2xl border border-dark-800">
                        <i data-lucide="bookmark-x" class="w-10 h-10 mx-auto mb-3 text-slate-600"></i>
                        <p class="text-xs sm:text-sm">No hay prompts guardados.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            container.innerHTML = filtered.map(item => `
                <div class="bg-dark-900/60 border border-dark-800 rounded-2xl p-4 sm:p-5 flex flex-col justify-between hover:border-emerald-500/30 transition-all shadow-lg">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[10px] font-mono text-emerald-300 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-md">${item.category || 'Guardado'}</span>
                            <span class="text-[10px] text-slate-500 font-mono">${item.date || ''}</span>
                        </div>
                        <h3 class="text-sm font-bold text-slate-100 mb-2">${item.title}</h3>
                        <p class="text-slate-300 text-xs font-mono line-clamp-3 mb-4 leading-relaxed bg-dark-950 p-2.5 rounded-xl border border-dark-800">${item.prompt}</p>
                    </div>
                    <div class="flex items-center gap-2 pt-2 border-t border-dark-800">
                        <button onclick="copyToClipboard(\`${item.prompt.replace(/`/g, '\\`')}\`)" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs py-2 px-3 rounded-xl transition-all flex items-center justify-center gap-1.5 shadow-md active:scale-95">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copiar
                        </button>
                        <button onclick="openEditModal('${item.id}')" class="p-2 text-slate-400 hover:text-indigo-300 hover:bg-dark-800 rounded-xl transition-colors" title="Editar"><i data-lucide="edit-3" class="w-4 h-4"></i></button>
                        <button onclick="deleteSavedPrompt('${item.id}')" class="p-2 text-slate-400 hover:text-rose-400 hover:bg-dark-800 rounded-xl transition-colors" title="Eliminar"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function renderStats() {
            const counts = {};
            PROMPT_LIBRARY.forEach(p => {
                counts[p.platform] = (counts[p.platform] || 0) + 1;
            });
            const container = document.getElementById('aiDistributionBars');
            if (!container) return;

            container.innerHTML = Object.entries(counts).map(([plat, count]) => {
                const pct = Math.round((count / PROMPT_LIBRARY.length) * 100);
                return `
                    <div>
                        <div class="flex justify-between text-xs text-slate-300 mb-1">
                            <span>${plat}</span>
                            <span class="font-mono text-indigo-400">${count} plantillas (${pct}%)</span>
                        </div>
                        <div class="w-full bg-dark-950 rounded-full h-2 border border-dark-800 overflow-hidden">
                            <div class="bg-gradient-to-r from-indigo-500 to-purple-500 h-full rounded-full" style="width: ${pct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function openEditModal(id) {
            const item = appState.savedPrompts.find(p => p.id === id);
            if (!item) return;
            document.getElementById('editPromptId').value = item.id;
            document.getElementById('editPromptTitle').value = item.title;
            document.getElementById('editPromptContent').value = item.prompt;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        function saveEditedPrompt() {
            const id = document.getElementById('editPromptId').value;
            const item = appState.savedPrompts.find(p => p.id === id);
            if (item) {
                item.title = document.getElementById('editPromptTitle').value.trim() || 'Prompt';
                item.prompt = document.getElementById('editPromptContent').value.trim();
                saveState();
                renderSavedPrompts();
                closeEditModal();
                showToast('Prompt actualizado');
            }
        }

        function deleteSavedPrompt(id) {
            appState.savedPrompts = appState.savedPrompts.filter(p => p.id !== id);
            saveState();
            updateSavedCount();
            renderSavedPrompts();
            showToast('Prompt eliminado');
        }

        function exportSavedPrompts() {
            if (appState.savedPrompts.length === 0) {
                showToast('No hay prompts guardados', 'error');
                return;
            }
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState.savedPrompts, null, 2));
            const dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", dataStr);
            dlAnchor.setAttribute("download", `promptforge_coleccion_${Date.now()}.json`);
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
        }

        function copyToClipboard(text) {
            if (!text) return;
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('Prompt copiado al portapapeles');
            } catch (err) {
                showToast('Error al copiar', 'error');
            } finally {
                document.body.removeChild(textarea);
            }
        }

        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            if (!toast || !toastMsg) return;
            toastMsg.innerText = msg;
            toast.className = `fixed bottom-20 md:bottom-5 right-5 ${type === 'error' ? 'bg-rose-600 text-white' : 'bg-emerald-600 text-white'} font-semibold px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 text-xs transition-all duration-300 z-50 pointer-events-none opacity-100 translate-y-0`;
            setTimeout(() => {
                toast.className = "fixed bottom-20 md:bottom-5 right-5 bg-emerald-600 text-white font-semibold px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 text-xs translate-y-20 opacity-0 transition-all duration-300 z-50 pointer-events-none";
            }, 2500);
        }
    </script>
</body>
</html>
